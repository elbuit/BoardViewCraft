            <string>Viewer</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cad</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>TestView Boardview File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>tvw</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
